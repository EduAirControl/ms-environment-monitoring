# ms-environment-monitoring - variables de entorno.
# Copia a .env y ajusta los valores. No subas un .env con secretos.

# Servidor
SERVER_PORT=3003

# PostgreSQL (ADR-003)
POSTGRES_URL=jdbc:postgresql://localhost:5435/eduaircontrol_monitoring
POSTGRES_USER=monitoring_user
POSTGRES_PASSWORD=change-me
SHOW_SQL=false
DB_CHANGELOG_CONTEXTS=

# Seguridad (ADR-006/018): access tokens RS256 validados contra el JWKS de ms-security
JWKS_URI=http://localhost:8081/api/v1/auth/jwks
JWT_PUBLIC_KEY_PATH=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# RabbitMQ / mensajeria (ADR-007)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
MESSAGING_LISTENERS_AUTO_STARTUP=true
MESSAGING_MAX_RETRIES=4
MESSAGING_INITIAL_RETRY_INTERVAL_MS=1000
MESSAGING_PREFETCH=50
INSTALLATIONS_EXCHANGE=eduaircontrol.sensor
INSTALLATIONS_QUEUE=eduaircontrol.sensor.ms-environment-monitoring
INSTALLATIONS_ROUTING_KEY=sensor.installation.*
CLASSROOM_EVENTS_EXCHANGE=eduaircontrol.classroom
CLASSROOM_EVENTS_QUEUE=eduaircontrol.classroom.ms-environment-monitoring
CLASSROOM_EVENTS_ROUTING_KEY=classroom.educational_environment.*

# Backfill historico desde el monolito (temporal)
BACKFILL_ENABLED=false
BACKFILL_INITIAL_RUN=false
BACKFILL_INITIAL_DAYS=400
BACKFILL_RESYNC_WINDOW=24h
BACKFILL_RESYNC_INTERVAL=6h
